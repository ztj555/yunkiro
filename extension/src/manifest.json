{
  "manifest_version": 3,
  "name": "YunKiro - One Click Dial",
  "version": "1.0.0",
  "description": "Cross-screen one-click dialing. Detect phone numbers and dial via your connected mobile device.",
  "permissions": ["activeTab", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YunKiro Dial"
  },
  "icons": {}
}
